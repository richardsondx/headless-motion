{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hme.scene/1.0",
  "title": "Headless Motion Engine scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "meta",
    "fonts",
    "palette",
    "nodes",
    "timeline",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "hme.scene/1.0",
      "x-error-code": "SCHEMA_VERSION"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height",
        "duration",
        "seed",
        "register"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "default": 24
        },
        "width": {
          "enum": [
            1920,
            1080
          ]
        },
        "height": {
          "enum": [
            1080,
            1920
          ]
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "description": "frames"
        },
        "seed": {
          "type": "integer"
        },
        "register": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "notes": {
          "description": "free text, exempt from additionalProperties"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "width": {
                  "const": 1920
                },
                "height": {
                  "const": 1080
                }
              },
              "required": [
                "width",
                "height"
              ]
            },
            {
              "properties": {
                "width": {
                  "const": 1080
                },
                "height": {
                  "const": 1920
                }
              },
              "required": [
                "width",
                "height"
              ]
            }
          ]
        }
      ]
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "weight",
          "src"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "src": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//)",
            "description": "local file path, relative to the scene file. No URLs."
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "properties": {
        "ground": {
          "anyOf": [
            {
              "$ref": "#/$defs/hex"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "color": {
                  "$ref": "#/$defs/hex"
                },
                "source": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "reference frame number the colour was measured on"
                }
              }
            },
            {
              "$ref": "#/$defs/gradient"
            }
          ]
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/hex"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "$ref": "#/$defs/hex"
              },
              "source": {
                "type": "integer",
                "minimum": 0,
                "description": "reference frame number the colour was measured on"
              }
            }
          }
        ]
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "f"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "f": {
            "$ref": "#/$defs/frame"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "gradientStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "at"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/colorRef"
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "gradient": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "angle",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "linear"
            },
            "angle": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "degrees, CSS convention (0 = to top, 90 = to right, 180 = to bottom)"
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/gradientStop"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cx",
            "cy",
            "r",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "radial"
            },
            "cx": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "r": {
              "type": "number",
              "minimum": 0,
              "description": "fraction of the shape box"
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/gradientStop"
              }
            }
          }
        }
      ]
    },
    "glow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "radius",
        "intensity"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/colorRef"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "px"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "soft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius"
      ],
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "px"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "colorRef": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z][A-Za-z0-9_-]*)$"
    },
    "frame": {
      "allOf": [
        {
          "type": "integer"
        },
        {
          "minimum": 0,
          "x-error-code": "KEY_RANGE"
        }
      ]
    },
    "ease": {
      "x-error-code": "UNKNOWN_EASE",
      "anyOf": [
        {
          "enum": [
            "linear",
            "hold",
            "easeInSine",
            "easeOutSine",
            "easeInOutSine",
            "easeInQuad",
            "easeOutQuad",
            "easeInOutQuad",
            "easeInCubic",
            "easeOutCubic",
            "easeInOutCubic",
            "easeInQuart",
            "easeOutQuart",
            "easeInOutQuart",
            "easeInQuint",
            "easeOutQuint",
            "easeInOutQuint",
            "easeOutBack",
            "easeInOutBack"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bezier"
          ],
          "properties": {
            "bezier": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "prop",
        "keys"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "prop": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "f",
              "v"
            ],
            "properties": {
              "f": {
                "$ref": "#/$defs/frame"
              },
              "v": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/pathPoint"
                    },
                    "description": "points list for a props.points morph track"
                  }
                ]
              },
              "ease": {
                "$ref": "#/$defs/ease"
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "parent",
        "z",
        "box",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "text",
            "shape",
            "image",
            "map",
            "chart",
            "particle"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "z": {
          "type": "integer"
        },
        "box": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number",
              "minimum": 0
            },
            "h": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "default": 0
            },
            "y": {
              "type": "number",
              "default": 0
            },
            "scale": {
              "type": "number",
              "default": 1
            },
            "scaleX": {
              "type": "number",
              "default": 1,
              "description": "non-uniform scale in x. When scaleX differs from scaleY, the shape squashes or stretches. Falls back to scale when absent."
            },
            "scaleY": {
              "type": "number",
              "default": 1,
              "description": "non-uniform scale in y. When scaleX differs from scaleY, the shape squashes or stretches. Falls back to scale when absent."
            },
            "anchorX": {
              "type": "number",
              "description": "box-local px x of the scale anchor. Absent means the box centre."
            },
            "anchorY": {
              "type": "number",
              "description": "box-local px y of the scale anchor. Absent means the box centre."
            },
            "rotation": {
              "type": "number",
              "default": 0,
              "description": "degrees"
            },
            "opacity": {
              "type": "number",
              "default": 1
            }
          }
        },
        "visible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in",
            "out"
          ],
          "properties": {
            "in": {
              "type": "integer",
              "minimum": 0
            },
            "out": {
              "type": "integer",
              "minimum": 0,
              "description": "exclusive"
            }
          }
        },
        "props": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/textProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shape"
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/shapeProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/imageProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "particle"
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/particleProps"
              }
            }
          }
        }
      ]
    },
    "textProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "font",
        "color"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "weight",
            "size"
          ],
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "integer"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "px"
            },
            "letterSpacing": {
              "type": "number",
              "description": "px"
            },
            "lineHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "unitless multiplier of size"
            }
          }
        },
        "color": {
          "$ref": "#/$defs/colorRef"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "maxWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ground": {
          "type": "string",
          "description": "id of the pill or bar shape node behind the text"
        },
        "kinetic": {
          "type": "object",
          "description": "Kinetic animation. Checked strictly against src/text/text.schema.json by validate.mjs checkText."
        }
      }
    },
    "xy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      },
      "description": "box-local px [x, y]"
    },
    "pathPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "anchor": {
          "$ref": "#/$defs/xy"
        },
        "in": {
          "anyOf": [
            {
              "$ref": "#/$defs/xy"
            },
            {
              "type": "null"
            }
          ],
          "description": "in-handle, box-local px. Null means the handle sits on the anchor."
        },
        "out": {
          "anyOf": [
            {
              "$ref": "#/$defs/xy"
            },
            {
              "type": "null"
            }
          ],
          "description": "out-handle, box-local px. Null means the handle sits on the anchor."
        },
        "command": {
          "enum": [
            "line",
            "cubic",
            "smooth"
          ],
          "description": "segment that arrives at this point from the previous point. The first point uses M and its command is ignored."
        }
      }
    },
    "shapeProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rect",
            "ellipse",
            "polygon",
            "path",
            "line"
          ]
        },
        "fill": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(none|#[0-9a-fA-F]{6}|[A-Za-z][A-Za-z0-9_-]*)$"
            },
            {
              "$ref": "#/$defs/gradient"
            }
          ]
        },
        "glow": {
          "$ref": "#/$defs/glow"
        },
        "soft": {
          "$ref": "#/$defs/soft"
        },
        "stroke": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "width"
          ],
          "properties": {
            "color": {
              "$ref": "#/$defs/colorRef"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "casing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color",
                "width"
              ],
              "properties": {
                "color": {
                  "$ref": "#/$defs/colorRef"
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "description": "extra px on each side of the stroke"
                }
              }
            }
          }
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "d": {
          "type": "string",
          "description": "path: SVG path data. polygon: 'x,y x,y ...'. Both in box-local px."
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathPoint"
          },
          "description": "path as data: named nodes. The renderer compiles this list to d. When both points and d are present, points wins. d stays as a fallback for traced scenes."
        },
        "closed": {
          "type": "boolean",
          "description": "append Z to the d compiled from points. Only used with points."
        },
        "deform": {
          "type": "array",
          "description": "vertex deform: move a named subset of points by dx, dy px. The evaluator adds the offset to the named point's anchor and handles. Points not named stay unchanged. An unknown id fails loudly.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dx",
              "dy"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "dx": {
                "type": "number",
                "description": "move in x, box-local px"
              },
              "dy": {
                "type": "number",
                "description": "move in y, box-local px"
              }
            }
          }
        }
      }
    },
    "imageProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "fit": {
          "enum": [
            "cover",
            "contain",
            "none"
          ]
        }
      }
    },
    "particleProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "size",
        "speed",
        "direction",
        "lifetime",
        "shape",
        "area"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "number of particles in the emitter"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "particle diameter in px"
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "travel speed in px per second"
        },
        "direction": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "travel direction in degrees, 0 = right, 90 = down, 270 = up"
        },
        "lifetime": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "particle lifetime in frames"
        },
        "shape": {
          "enum": [
            "circle",
            "star",
            "bubble"
          ],
          "description": "star maps to a computed polygon downstream (existing SVG path kind), not a new shape kind"
        },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "description": "emitter area left in scene px"
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "description": "emitter area top in scene px"
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "emitter area width in scene px"
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "emitter area height in scene px"
            }
          }
        }
      }
    }
  }
}