{
 "$defs": {
  "badge": {
   "additionalProperties": false,
   "properties": {
    "at": {
     "items": {
      "type": "number"
     },
     "type": "array"
    },
    "id": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "mode": {
     "enum": [
      "disc",
      "hex"
     ],
     "type": "string"
    },
    "f": {
     "type": "number"
    }
   },
   "required": [
    "id",
    "label"
   ],
   "type": "object"
  },
  "cameraMove": {
   "additionalProperties": false,
   "properties": {
    "bearing": {
     "type": "number"
    },
    "center": {
     "items": {
      "type": "number"
     },
     "type": "array"
    },
    "ease": {
     "type": "string"
    },
    "event": {
     "type": "string"
    },
    "pitch": {
     "type": "number"
    },
    "travel": {
     "type": "number"
    },
    "zoom": {
     "type": "number"
    },
    "followRoute": {
     "type": "string"
    }
   },
   "required": [
    "event",
    "center",
    "zoom"
   ],
   "type": "object"
  },
  "focusEvent": {
   "additionalProperties": false,
   "properties": {
    "event": {
     "type": "string"
    },
    "flood": {
     "type": "string"
    },
    "subject": {
     "type": "string"
    },
    "subjectStroke": {
     "description": "Draw the red subject outline on the focus country. Default true. Set false when the reference has no outline.",
     "type": "boolean"
    },
    "point": {
     "items": {
      "type": "number"
     },
     "type": "array"
    }
   },
   "required": [
    "event",
    "subject"
   ],
   "type": "object"
  },
  "label": {
   "additionalProperties": false,
   "properties": {
    "at": {
     "type": "number"
    },
    "id": {
     "type": "string"
    },
    "mode": {
     "enum": [
      "pill",
      "curved",
      "leader",
      "bare"
     ],
     "type": "string",
     "description": "bare: caps text only, no pill, no leader. Text renders navy #14213D. The label must declare ground, the fill it sits over, and G8 checks navy on that ground at 7:1."
    },
    "target": {
     "type": [
      "string",
      "array"
     ]
    },
    "text": {
     "type": "string"
    },
    "ground": {
     "type": [
      "string",
      "null"
     ]
    },
    "dx": {
     "type": "number",
     "description": "Added in hme.map 1.1. Leader-mode horizontal offset in px from the point to the pill centre (1920x1080). Default 0. The leader then runs from the point to the pill."
    },
    "dy": {
     "type": "number",
     "description": "Leader-mode vertical offset in px from the point to the pill centre (1920x1080). Default -70. Negative moves the pill up."
    }
   },
   "required": [
    "id",
    "target",
    "text",
    "at"
   ],
   "type": "object"
  },
  "route": {
   "additionalProperties": false,
   "properties": {
    "coords": {
     "items": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "type": "array"
    },
    "draw": {
     "type": "number"
    },
    "ease": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "start": {
     "type": "number"
    },
    "color": {
     "type": "string"
    },
    "dashed": {
     "type": "boolean",
     "description": "Dashed route: casing and segments share one dash pattern. Harris arc fan."
    }
   },
   "required": [
    "id",
    "coords",
    "start",
    "draw"
   ],
   "type": "object"
  }
 },
 "$id": "hme.map/1.0",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "badges": {
   "items": {
    "$ref": "#/$defs/badge"
   },
   "type": "array"
  },
  "borderStroke": {
   "description": "Draw border lines between countries. Default true. Set false when the reference has no border lines, only fill changes.",
   "type": "boolean"
  },
  "camera": {
   "items": {
    "$ref": "#/$defs/cameraMove"
   },
   "type": "array"
  },
  "focusMode": {
   "description": "Added in hme.map 1.1, optional. 'single' (default) floods only the current focus subject. 'cumulative' keeps each earlier subject's flood after the focus moves on, dimmed like other non-subject land, so there is still exactly one focus.",
   "enum": [
    "single",
    "cumulative"
   ],
   "type": "string"
  },
  "focus": {
   "items": {
    "$ref": "#/$defs/focusEvent"
   },
   "type": "array"
  },
  "geometry": {
   "additionalProperties": false,
   "properties": {
    "countries": {
     "type": "string"
    },
    "key": {
     "description": "GeoJSON property name the include values match against. Default ISO_A3 (countries). Use iso_3166_2 for the US states file.",
     "type": "string"
    },
    "include": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "include"
   ],
   "type": "object"
  },
  "labels": {
   "items": {
    "$ref": "#/$defs/label"
   },
   "type": "array"
  },
  "register": {
   "enum": [
    "light",
    "dark"
   ],
   "type": "string"
  },
  "routes": {
   "items": {
    "$ref": "#/$defs/route"
   },
   "type": "array"
  }
 },
 "required": [
  "register",
  "geometry"
 ],
 "type": "object"
}