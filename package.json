{
  "name": "headless-motion",
  "description": "Motion graphics from JSON scenes. No timeline UI, no manual keyframes. An agent writes a scene, the engine renders the video, and a checker scores every frame against a reference.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsondx/headless-motion.git"
  },
  "private": true,
  "type": "module",
  "bin": { "hme": "src/cli/hme.mjs" },
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/scene/ tests/renderer/",
    "lint:determinism": "node src/scene/lint-determinism.mjs src"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.9.20",
    "playwright-core": "1.57.0"
  }
}
